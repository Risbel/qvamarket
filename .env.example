# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=qvashop
POSTGRES_PASSWORD=qvashop
POSTGRES_DB=qvashop
POSTGRES_PORT=5432

# Connection string used by packages/db and apps/web
DATABASE_URL=postgresql://qvashop:qvashop@localhost:5432/qvashop

# Better Auth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Root domain for subdomain routing (hostname only, no port): localhost in dev, qvashop.com in prod
ROOT_DOMAIN=localhost

# Object storage (SeaweedFS, S3 API). Change the secret outside local dev.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=qvashop-media
S3_ACCESS_KEY=qvashop-access
S3_SECRET_KEY=qvashop-secret-change-me
# Base URL where files are publicly readable (bucket included, no trailing slash)
S3_PUBLIC_URL=http://localhost:8333/qvashop-media

# Dev only: pretend the visitor is in this country (ISO code, e.g. CU) to test the default
# storefront currency. In production the country comes from Cloudflare's cf-ipcountry header.
# DEV_VISITOR_COUNTRY=CU

# Daily billing job: POST /api/cron/billing with "Authorization: Bearer <CRON_SECRET>" (Dokploy schedule).
# At least 16 characters; without it the route answers 503. Generate with: openssl rand -base64 32
CRON_SECRET=

# Platform contact shown on the merchant Billing page to pay or ask (international, e.g. +5355555555)
PLATFORM_WHATSAPP=
