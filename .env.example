# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=qvashop
POSTGRES_PASSWORD=qvashop
POSTGRES_DB=qvashop
POSTGRES_PORT=5432

# Connection string used by packages/db and apps/web
DATABASE_URL=postgresql://qvashop:qvashop@localhost:5432/qvashop

# Better Auth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Root domain for subdomain routing (hostname only, no port): localhost in dev, qvashop.com in prod
ROOT_DOMAIN=localhost
